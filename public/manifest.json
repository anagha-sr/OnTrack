{
  "manifest_version": 3,
  "name": "OnTrack",
  "version": "1.0.0",
  "description": "A productivity extension for timers, tasks, and website tracking.",

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "128": "images/icon-128.png"
    }
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ]
}